includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    paths:
        - app/

    ignoreErrors:
        # Both Concerns traits are used only by Livewire SFCs under
        # resources/views/pages, which are Blade and so cannot be analyzed.
        - identifier: trait.unused
          path: app/Concerns/*
